        "vertical-align:top; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;'>"
        f"<div style='font-size:13px; font-weight:600;'>{titolo}</div>"
        f"<div style='font-size:11px; color:#64748b; margin:4px 0 8px;'>"
        f"<span style='{quadratino}{AMBRA};'></span>{legenda[0]} &nbsp; "
        f"<span style='{quadratino}{VERDE};'></span>{legenda[1]}</div>"
        f"<table style='width:100%; table-layout:fixed; border-collapse:collapse; border-bottom:1px solid #cbd5e1;'>"
        f"<tr>{barre}</tr></table>"
        f"<table style='width:100%; table-layout:fixed; border-collapse:collapse;'><tr>{etichette}</tr></table>"
        "</div>"
    )


class ReportFormatter:

    @staticmethod
    def format_weekly_html(llm_html: str, risultato: dict) -> str:
        """Report settimanale: testo e tabelle scritti dall'LLM, indicatori e grafici calcolati dal codice."""
        html = llm_html.replace("```html", "").replace("```", "")

        grafici = risultato["grafici"]
        legenda = (risultato["periodo_precedente"], risultato["periodo"])
        html = _inserisci(html, "[[GRAFICO_DISCOVER]]",
                          _grafico_html("Clic da Discover al giorno", grafici["discover"], grafici["giorni"], legenda))
        html = _inserisci(html, "[[GRAFICO_WEB]]",
                          _grafico_html("Clic da ricerca web al giorno", grafici["web"], grafici["giorni"], legenda))

        # Gli indicatori vanno dopo la sintesi, prima della prima sezione
        kpi = _kpi_html(risultato["dati"])
        html = html.replace("<h2", kpi + "<h2", 1) if "<h2" in html else html + kpi

        return (
            f"<html><head><meta charset='utf-8'>{STILE}</head>"
            f"<body><div class='report'><div class='testo'>{html}</div></div></body></html>"
        )

    @staticmethod
    def format_html(data: ReportData, narrative: str) -> str:
        query_rows = "".join(
            f"<tr><td>{q.query}</td><td>{q.clicks}</td><td>{q.impressions}</td><td>{q.position}</td></tr>"
            for q in data.top_queries
        ) or "<tr><td colspan='4'>Nessuna query disponibile</td></tr>"

        page_rows = "".join(
            f"<tr><td>{p.page}</td><td>{p.clicks}</td><td>{p.impressions}</td><td>{p.position}</td></tr>"
            for p in data.top_pages
        ) or "<tr><td colspan='4'>Nessuna pagina disponibile</td></tr>"

        narrative_html = narrative.replace("\n", "<br>")

        return f"""
        <html>
        <body style="font-family: Arial, sans-serif; color: #333; line-height: 1.6;">
            <h2>Report SEO — Periodo: {data.period}</h2>
            <p>
                <strong>Click Totali:</strong> {data.total_clicks} ({data.clicks_delta_pct}%) |
                <strong>Impressioni:</strong> {data.total_impressions} |
                <strong>CTR Medio:</strong> {data.avg_ctr * 100:.2f}% |
                <strong>Posizione Media:</strong> {data.avg_position}
            </p>

            <h3>Analisi Strategica</h3>
            <p style="background: #f4f6f8; padding: 12px; border-left: 4px solid #2563eb;">
                {narrative_html}
            </p>

            <h3>Top 5 Query</h3>
            <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                <tr style="background: #e2e8f0;">
                    <th>Query</th><th>Click</th><th>Impressioni</th><th>Posizione</th>
                </tr>
                {query_rows}
            </table>

            <h3>Top 5 Pagine</h3>
            <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                <tr style="background: #e2e8f0;">
                    <th>Pagina</th><th>Click</th><th>Impressioni</th><th>Posizione</th>
                </tr>
                {page_rows}
            </table>
        </body>
        </html>
        """

    @staticmethod
    def format_json(data: ReportData, narrative: str) -> dict:
        return {
            "metrics": data.model_dump(),
            "narrative": narrative
        }

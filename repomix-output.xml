    <header>
        <h1>Report SEO</h1>
        <p>Carica i dati di Google Search Console e ottieni un report professionale</p>
    </header>

    <main>
        <div class="card">
            <h2><span class="step">1</span>Seleziona i file CSV</h2>
            <label class="pick" for="csvInput">Clicca qui per scegliere i file (anche più di uno)</label>
            <input type="file" id="csvInput" accept=".csv" multiple>
            <p id="fileNames"></p>
        </div>

        <div class="card">
            <h2><span class="step">2</span>Genera il report</h2>
            <button id="btnGenera">Crea il report e invialo via email</button>
            <p id="status"></p>
        </div>

        <div class="card" id="result" style="display:none;">
            <div class="risultato-testa">
                <h2>Il tuo report</h2>
                <button id="btnPdf">Scarica PDF</button>
            </div>
            <iframe id="preview"></iframe>
        </div>
    </main>

    <script>
        const input     = document.getElementById('csvInput');
        const fileNames = document.getElementById('fileNames');
        const button    = document.getElementById('btnGenera');
        const btnPdf    = document.getElementById('btnPdf');
        const status    = document.getElementById('status');
        const result    = document.getElementById('result');
        const preview   = document.getElementById('preview');

        function showStatus(text, type = "") {
            status.textContent = text;
            status.className = type;
        }

        // L'anteprima si allunga quanto il report, così si scorre solo la pagina
        function adattaAltezza() {
            preview.style.height = preview.contentDocument.documentElement.scrollHeight + "px";
        }
        preview.onload = adattaAltezza;
        window.onresize = adattaAltezza;

        input.onchange = () => {
            const names = Array.from(input.files).map(file => file.name);
            fileNames.textContent = names.length ? "File selezionati: " + names.join(" · ") : "";
        };

        // Apre la stampa del browser: scegliendo "Salva come PDF" si scarica il report
        btnPdf.onclick = () => {
            preview.contentWindow.focus();
            preview.contentWindow.print();
        };

        button.onclick = async () => {
            if (input.files.length === 0) {
                showStatus("Seleziona prima almeno un file CSV.", "err");
                return;
            }

            button.disabled = true;
            showStatus("Sto preparando il report...");

            const formData = new FormData();
            for (const file of input.files) {
                formData.append("files", file);
            }

            try {
                const res  = await fetch("/api/upload-report", { method: "POST", body: formData });
                const data = await res.json();
                if (!res.ok) throw new Error(data.detail || "Qualcosa è andato storto, riprova.");

                preview.srcdoc = data.report_html;
                preview.style.display = "block";
                result.style.display = "block";
                showStatus(
                    data.email_sent
                        ? "Report pronto e inviato via email."
                        : "Report pronto. L'invio via email non è attivo.",
                    "ok"
                );
                result.scrollIntoView({ behavior: "smooth" });
            } catch (err) {
                const isNetworkError = err instanceof TypeError;
                showStatus(isNetworkError ? "Server non raggiungibile, riprova." : err.message, "err");
            } finally {
                button.disabled = false;
            }
        };
    </script>
</body>

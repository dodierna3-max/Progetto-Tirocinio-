<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Generatore Report SEO</title>
    <style>
        body { font-family: Arial, sans-serif; background: #121212; color: #eaeaea; max-width: 800px; margin: 40px auto; padding: 20px; }
        .card { background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 24px; margin-bottom: 24px; }
        h1, h2 { color: #d4af37; margin-top: 0; }
        input[type="file"] { display: block; margin: 16px 0; color: #ccc; }
        button { background: #d4af37; color: #121212; border: none; padding: 12px 24px; font-size: 15px; font-weight: bold; border-radius: 6px; cursor: pointer; }
        button:disabled { opacity: 0.5; cursor: wait; }
        #status { margin-top: 12px; font-size: 14px; color: #aaa; }
        #preview { background: #ffffff; color: #222222; padding: 20px; border-radius: 6px; min-height: 120px; }
    </style>
</head>
<body>

    <div class="card">
        <h1>Generazione Report SEO</h1>
        <p>Seleziona un file CSV dal computer (oppure lascia vuoto per usare i dati di default):</p>
        <input type="file" id="csvInput" accept=".csv">
        <button id="btnGenera" onclick="generaReport()">Genera Report e Invia Email</button>
        <p id="status"></p>
    </div>

    <div class="card">
        <h2>Anteprima del Report</h2>
        <div id="preview"><em>Nessun report generato. Clicca sul bottone sopra per vedere l'anteprima.</em></div>
    </div>

    <script>
        async function generaReport() {
            const btn = document.getElementById('btnGenera');
            const status = document.getElementById('status');
            const preview = document.getElementById('preview');
            const fileInput = document.getElementById('csvInput');

            btn.disabled = true;
            status.textContent = "Generazione del report e invio email in corso...";

            const formData = new FormData();
            if (fileInput.files.length > 0) {
                formData.append("file", fileInput.files[0]);
            }

            try {
                const res = await fetch('/api/generate-report', { method: 'POST', body: formData });
                const data = await res.json();

                if (!res.ok) throw new Error(data.detail || "Errore durante la generazione");

                preview.innerHTML = data.html_preview;
                status.textContent = "Completato! Email inviata: " + (data.email_sent ? "Sì" : "No");
            } catch (err) {
                status.textContent = "Errore: " + err.message;
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>

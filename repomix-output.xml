import io
import pandas as pd
from fastapi import APIRouter, HTTPException, UploadFile, File
from models.analysis_model import SEOAnalyzer
from view.Llm_view import LLMReportView
from view.report_view import ReportFormatter
from utils.notifier import EmailNotifier, TelegramNotifier

router = APIRouter()

COLUMN_MAP = {
    "top queries": "query", "query principali": "query", "query": "query",
    "clicks": "clicks", "clic": "clicks",
    "impressions": "impressions", "impressioni": "impressions",
    "ctr": "ctr",
    "position": "position", "average position": "position",
    "posizione": "position", "posizione media": "position",
    "page": "page", "top pages": "page", "landing page": "page",
    "pagina": "page", "pagina di destinazione": "page",
    "date": "date", "data": "date",
}


def parse_csv(content: bytes) -> list[dict]:
    df = pd.read_csv(io.BytesIO(content))
    df.columns = [COLUMN_MAP.get(c.strip().lower(), c.strip().lower()) for c in df.columns]

    if "ctr" in df.columns:
        df["ctr"] = df["ctr"].astype(str).str.replace("%", "").astype(float)
        if df["ctr"].max() > 1:
            df["ctr"] = df["ctr"] / 100.0

    return df.to_dict(orient="records")


@router.get("/health")
def health_check():
    return {"status": "online", "service": "SEO Reporting MVC"}


@router.post("/upload-report")
def upload_report(file: UploadFile = File(...)):
    if not file.filename.endswith(".csv"):
        raise HTTPException(status_code=400, detail="Formato non valido. Carica un file .csv")

    try:
        content = file.file.read()
        rows = parse_csv(content)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Errore lettura CSV: {e}")

    if not rows:
        raise HTTPException(status_code=400, detail="Il file CSV è vuoto")

    page_rows = [r for r in rows if r.get("page")]
    period = f"Report da file: {file.filename}"

    report_data = SEOAnalyzer.analyze_data(
        current_raw=rows,
        previous_raw=[],
        page_raw=page_rows,
        daily_raw=[r for r in rows if r.get("date")],
        period_label=period
    )

    llm = LLMReportView()
    try:
        narrative = llm.generate_narrative(report_data)
    except Exception as e:
        print(f"[LLM ERROR] {type(e).__name__}: {e}")
        narrative = f"Riepilogo AI non disponibile ({e})."

    html_content = ReportFormatter.to_html(report_data, narrative)
    subject = f"Report SEO — {file.filename}"

    email_sent = EmailNotifier().send(subject, html_content)
    telegram_sent = TelegramNotifier().send(subject, narrative)

    result = ReportFormatter.to_json_response(report_data, narrative, email_sent)
    result["telegram_sent"] = telegram_sent
    result["report_html"] = html_content
    return result

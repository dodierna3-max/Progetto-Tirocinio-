            const data = await res.json();
            if (!res.ok) {
                status.className = 'status error';
                status.textContent = '❌ Errore: ' + (data.detail || 'Errore sconosciuto');
                btnGen.disabled = false;
                return;
            }
            // Status
            const emailOk = data.email_dispatched ? '✅ Email inviata' : '⚠️ Email non inviata (controlla SMTP)';
            status.className = 'status success';
            status.textContent = '✅ Report generato! ' + emailOk;
            // Preview
            if (data.report_html) {
                prevCard.style.display = 'block';
                preview.srcdoc = data.report_html;
            }
        } catch (e) {
            status.className = 'status error';
            status.textContent = '❌ Errore di rete: ' + e.message;
        }
        btnGen.disabled = false;
    });

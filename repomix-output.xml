from fastapi import APIRouter, HTTPException, UploadFile, File
from models.weekly_model import leggi_csv, analizza_settimana
from view.Llm_view import LLMReportView
from view.report_view import ReportFormatter
from utils.notifier import EmailNotifier, TelegramNotifier

router = APIRouter()

# Se l'LLM non risponde il report esce comunque, con indicatori e grafici
TESTO_NON_DISPONIBILE = (
    "<h1>Report settimanale</h1>"
    "<p>Il testo di analisi non è al momento disponibile: trovi qui sotto i dati principali.</p>"
    "<h2>Andamento giornaliero</h2>[[GRAFICO_DISCOVER]][[GRAFICO_WEB]]"
)


@router.get("/health")
def health_check():
    return {"status": "online", "service": "SEO Reporting MVC"}


@router.post("/upload-report")
def upload_report(files: list[UploadFile] = File(...)):
    pagine = query = None

    for file in files:
        try:
            df = leggi_csv(file.file)
        except Exception as e:
            print(f"[CSV ERROR] {file.filename}: {type(e).__name__}: {e}")
            raise HTTPException(
                status_code=400,
                detail=f"Il file \"{file.filename}\" non ha il formato atteso "
                       "(export giornaliero di Search Console per pagina o per query)."
            )
        # Il tipo di file si riconosce dalle colonne
        if "page" in df.columns:
            pagine = df
        elif "query" in df.columns:
            query = df

    if pagine is None or query is None:
        raise HTTPException(status_code=400, detail="Carica due file: l'export giornaliero per pagina e quello per query.")

    try:
        risultato = analizza_settimana(pagine, query)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

    try:
        llm_html = LLMReportView().generate_weekly_html(risultato)
    except Exception as e:
        print(f"[LLM ERROR] {e}")
        llm_html = TESTO_NON_DISPONIBILE

    html_content = ReportFormatter.format_weekly_html(llm_html, risultato)
    subject = f"Report settimanale SEO ({risultato['periodo']})"

    dati = risultato["dati"]
    riassunto = (f"{risultato['periodo']}: {dati['clic_totali']} clic "
                 f"({dati['clic_totali_variazione']} rispetto a {risultato['periodo_precedente']}).")

    return {
        "report_html": html_content,
        "email_sent": EmailNotifier().send(subject, html_content),
        "telegram_sent": TelegramNotifier().send(subject, riassunto),
    }
